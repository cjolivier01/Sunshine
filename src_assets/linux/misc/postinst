#!/bin/sh

# Load uhid (DS5 emulation)
echo "Loading uhid kernel module for DS5 emulation."
modprobe uhid

# Check if we're in an rpm-ostree environment
if [ ! -x "$(command -v rpm-ostree)" ]; then
  echo "Not in an rpm-ostree environment, proceeding with post install steps."

  # Ensure Sunshine can grab images from KMS
  path_to_setcap=$(command -v setcap)

  # Debian maintainer scripts can run with a restricted PATH that may not
  # include /usr/local/bin, so resolve Sunshine from common install locations.
  path_to_sunshine=""
  for candidate in "$(command -v sunshine 2>/dev/null || true)" /usr/bin/sunshine /usr/local/bin/sunshine ; do
    if [ -n "$candidate" ] && [ -e "$candidate" ] ; then
      resolved_candidate=$(readlink -f "$candidate")
      if [ -f "$resolved_candidate" ] ; then
        path_to_sunshine="$resolved_candidate"
        break
      fi
    fi
  done

  if [ -x "$path_to_setcap" ] && [ -n "$path_to_sunshine" ] ; then
    echo "Setting CAP_SYS_ADMIN, CAP_SYS_NICE capabilities on Sunshine binary."
    echo "$path_to_setcap cap_sys_admin,cap_sys_nice+p $path_to_sunshine"
    if "$path_to_setcap" cap_sys_admin,cap_sys_nice+p "$path_to_sunshine" ; then
      echo "CAP_SYS_ADMIN, CAP_SYS_NICE capabilities set on Sunshine binary."
    else
      echo "error: failed to set capabilities on Sunshine binary."
    fi
  elif [ ! -x "$path_to_setcap" ] ; then
    echo "error: setcap not found or not executable."
  else
    echo "error: Sunshine binary not found at expected locations."
  fi

  # Trigger udev rule reload for /dev/uinput and /dev/uhid
  path_to_udevadm=$(command -v udevadm)
  if [ -x "$path_to_udevadm" ] ; then
    echo "Reloading udev rules."
    $path_to_udevadm control --reload-rules
    $path_to_udevadm trigger --property-match=DEVNAME=/dev/uinput
    $path_to_udevadm trigger --property-match=DEVNAME=/dev/uhid
    echo "Udev rules reloaded successfully."
  else
    echo "error: udevadm not found or not executable."
  fi
else
  echo "rpm-ostree environment detected, skipping post install steps. Restart to apply the changes."
fi

if [ -x "/usr/share/sunshine/tools/configure-sunshine-host.sh" ] ; then
  echo "Tip: run /usr/share/sunshine/tools/configure-sunshine-host.sh to configure a user-level Sunshine service."
fi
